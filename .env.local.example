# Copy to .env.local and fill in with a real Supabase project's values
# (Project Settings -> API in the dashboard, or `supabase status` for a
# local project started with `supabase start`).
#
# Both variables below are safe to expose to the browser — that's what
# NEXT_PUBLIC_ means here. Never put SUPABASE_SERVICE_ROLE_KEY (or any
# other secret/admin key) in a NEXT_PUBLIC_* variable or in any file that
# ships to the client. It is not used anywhere in this phase.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI Coach (src/lib/ai/) — server-only, no NEXT_PUBLIC_ prefix. Never read
# from a Client Component; only src/lib/ai/config.ts (and, through it,
# src/app/api/coach/route.ts) touches these. The OpenAI API is billed
# independently of any ChatGPT subscription — get a key from
# https://platform.openai.com/api-keys.

# Required for the AI Coach conversation/Routine Draft to work at all.
# Without it, the deterministic Coach V1 screen (summary, "Mejorando",
# "A tener en cuenta") still works — only the chat/Draft feature is unavailable.
OPENAI_API_KEY=

# Optional. Defaults to the model OpenAI's current docs recommend as the
# general-purpose default (see src/lib/ai/config.ts) when unset. Override
# here to pin a specific model/snapshot or switch to a cheaper/faster tier
# your account has access to — never hardcoded elsewhere in the app.
COACH_MODEL=
